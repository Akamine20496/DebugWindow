package funkin.play;

import funkin.Conductor;
import funkin.Paths;
import funkin.play.PlayState;
import funkin.save.Save;
import funkin.modding.events.CountdownScriptEvent;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.ScriptEvent.StateChangeScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.modding.module.Module;
import flixel.FlxG;
import openfl.display.Sprite;
import openfl.display.Shape;
import openfl.text.Font;
import openfl.text.TextField;
import openfl.text.TextFormat;
import openfl.utils.Assets;
import openfl.system.System;
import StringTools;

class DebugWindow extends Module
{
  // OpenFL window containers
  var statusWindow:Sprite;
  var logWindow:Sprite;

  var windowsCreated:Bool = false;

  // Window properties
  var statusWindowWidth:Int = 380;
  var logWindowWidth:Int = 380;
  var windowHeight:Int = 80;
  var maxWindowHeight:Int = 360;
  var titleBarHeight:Int = 34;
  var cornerRadius:Float = 18;
  // previous height of the windows
  var lastStatusHeight:Int = -1;
  var lastLogHeight:Int = -1;

  // Status window and OpenFL children
  var STATUS(default, null):Int = 0;
  var defaultStatusContent:String = "[Status] Waiting for status update";
  var statusBackground:Shape;
  var statusTitleBar:Shape;
  var statusTitle:TextField;
  var statusText:TextField;

  // Log window and OpenFL children
  var LOG(default, null):Int = 1;
  var defaultLogContent:String = "[Log] Waiting for log update";
  var logBackground:Shape;
  var logTitleBar:Shape;
  var logTitle:TextField;
  var logText:TextField;

  // FIFO log
  var messages:Array<String> = [];
  var maxMessages:Int = 10;
  var isDefaultLogsDisabled:Bool = false;

  // Performance Tracking
  var statusRefreshTimer:Float = 0;
  var refreshInterval:Float = 1; // 1s
  var fpsElapsed:Float = 0;
  var fpsFrameCount:Int = 0;
  var currentFPS:Int = 0;
  var frameMs:Float = 0;
  var gcMem:String = "0 MB / 0 MB";
  var peakMemBytes:Float = 0;
  // 1% low fps
  var frameTimes:Array<Float> = [];
  var maxSamples:Int = 300;
  var windowSeconds:Int = 10;
  var onePercentLowFPS:Int = 0;

  // values from option page
  var windowMode:String;
  var windowOpacity:Float;

  // resolved font names and embed state
  var titleFontName:String;
  var titleFontEmbedded:Bool;
  var contentFontName:String;
  var contentFontEmbedded:Bool;

  public function new()
  {
    super("DebugWindow");
  }

  // setter functions for option page section
  public function setWindowMode(value:String):Void
  {
    try
    {
      value = value.toLowerCase();

      if (!["none", "basic", "full"].contains(value))
        throw 'Invalid debug window mode: $value';

      windowMode = value;
    }
    catch (e:Dynamic)
    {
      log('[Window Mode Option] ${Std.string(e)}. Setting back to Full.');
      windowMode = 'full';
    }

    applyVisibility();
  }

  public function setWindowOpacity(value:Float):Void
  {
    try
    {
      if (!(value >= 0.0 && value <= 1.0))
        throw 'Invalid window opacity value: $value';

      windowOpacity = value;
    }
    catch (e:Dynamic)
    {
      log('[Window Opacity Option] ${Std.string(e)}. Setting back to 40%.');
      windowOpacity = 0.4;
    }

    // update opacity of status window
    if (statusBackground != null) statusBackground.alpha = windowOpacity;
    if (statusTitleBar != null) statusTitleBar.alpha = windowOpacity;
    // update opacity of debug console window
    if (logBackground != null) logBackground.alpha = windowOpacity;
    if (logTitleBar != null) logTitleBar.alpha = windowOpacity;
  }

  // class functions and lifecycle section
  function loadOptionValues():Void
  {
    try
    {
      windowMode = cast Save.instance.modOptions.get("debugWindowMode");
      windowOpacity = cast Save.instance.modOptions.get("debugWindowOpacity");
    }
    catch (_:Dynamic)
    {
      log('[Window Options] Fallback to default values.');
      windowMode = 'full';
      windowOpacity = 0.4;
    }
  }

  function loadAndRegisterFont(fontFileName:String, defaultFontName:String = "_sans"):
    {
      fontName:String,
      embedded:Bool
    }
  {
    var resolvedFontPath:String = null;

    // check if the font path is existing
    if (fontFileName != null && StringTools.trim(fontFileName) != "")
    {
      var fontFromPath:String = Paths.font(fontFileName);

      if (fontFromPath != null)
      {
        resolvedFontPath = fontFromPath;
      }
    }

    if (resolvedFontPath != null) {
      // get the font using the path
      var font:Font = FlxG.assets.getFont(resolvedFontPath);
      // register the font
      Font.registerFont(font);

      // return the custom font
      return {
        fontName: font.fontName,
        embedded: true
      };
    }

    // return the default font
    return {
      fontName: defaultFontName,
      embedded: false
    };
  }

  function applyVisibility():Void
  {
    if (statusWindow == null && logWindow == null) return;

    switch (windowMode)
    {
      case 'none':
      {
        statusWindow.visible = false;
        logWindow.visible = false;
      }
      case 'basic':
      {
        statusWindow.visible = true;
        logWindow.visible = false;
      }
      case 'full':
      {
        statusWindow.visible = true;
        logWindow.visible = true;
      }
    }
  }

  function safe(value:Dynamic, fallback:String = "NULL"):String
  {
    if (value == null) return fallback;

    var result:String = Std.string(value);

    if (result == null || StringTools.trim(result) == "") return fallback;

    return result;
  }

  function getMemoryLabel():String
  {
    var currentBytes:Float = System.totalMemoryNumber;

    if (currentBytes > peakMemBytes) peakMemBytes = currentBytes;

    return '${formatBytes(currentBytes)} / ${formatBytes(peakMemBytes)}';
  }

  function formatBytes(bytes:Float):String
  {
    var mb:Float = bytes / 1024 / 1024;

    if (mb >= 1024)
    {
      var gb:Float = Math.round((mb / 1024) * 100) / 100;
      return '$gb GB';
    }

    var roundedMb:Float = Math.round(mb * 100) / 100;
    return '$roundedMb MB';
  }

  // Quickselect to sort the frame times
  function selectKthLargest(arr:Array<Float>, k:Int):Void
  {
    var left:Int = 0;
    var right:Int = arr.length - 1;

    while (left < right)
    {
      var pivot:Float = arr[left + Std.int((right - left) / 2)];
      var i:Int = left;
      var j:Int = right;

      // Partition so larger frame times move toward the front.
      while (i <= j)
      {
        while (arr[i] > pivot) i++;
        while (arr[j] < pivot) j--;

        if (i <= j)
        {
          var temp:Float = arr[i];
          arr[i] = arr[j];
          arr[j] = temp;

          i++;
          j--;
        }
      }

      if (k <= j)
        right = j;
      else
        left = i;
    }
  }

  function calculateOnePercentLow():Int
  {
    var count:Int = frameTimes.length;

    if (count == 0) return 0;

    var lowCount:Int = Std.int(Math.max(1, Math.ceil(count * 0.01 - 0.000001)));

    // Arrange the slowest lowCount frame times at the front.
    selectKthLargest(frameTimes, lowCount - 1);

    var lowSum:Float = 0.0;
    for (i in 0...lowCount) lowSum += frameTimes[i];

    var avgLowDelta:Float = lowSum / lowCount;

    if (avgLowDelta <= 0) return 0;

    // elapsed is in seconds, so convert seconds/frame to FPS.
    return Math.round(1.0 / avgLowDelta);
  }

  function drawShape(shape:Shape, width:Float, height:Float, color:Int)
  {
    shape.graphics.clear();
    shape.graphics.beginFill(color);
    shape.graphics.drawRoundRect(0, 0, width, height, cornerRadius, cornerRadius);
    shape.graphics.endFill();
  }

  function createPanel(x:Float, y:Float, width:Int, height:Int, title:String, content:String, isConsole:Bool):
    {
      container:Sprite,
      background:Shape,
      titleBar:Shape,
      titleField:TextField,
      contentField:TextField
    }
  {
    var container:Sprite = new Sprite();
    container.x = x;
    container.y = y;
    container.mouseEnabled = false;
    container.mouseChildren = false;

    var background:Shape = new Shape();
    drawShape(background, width, height, 0x101820); // draw background
    background.alpha = windowOpacity;
    container.addChild(background);

    var titleBar:Shape = new Shape();
    drawShape(titleBar, width, titleBarHeight, 0x243746); // draw title bar
    titleBar.alpha = windowOpacity;
    container.addChild(titleBar);

    var titleFormat:TextFormat = new TextFormat(titleFontName, 20, 0xFFFFFF, true);
    var titleField:TextField = new TextField();
    titleField.embedFonts = titleFontEmbedded;
    titleField.defaultTextFormat = titleFormat;
    titleField.text = title;
    titleField.x = 8;
    titleField.y = 4;
    titleField.width = width - 16;
    titleField.height = titleBarHeight - 4;
    titleField.selectable = false;
    titleField.mouseEnabled = false;
    container.addChild(titleField);

    var textColor:Int = isConsole ? 0x00FF00 : 0xFFFFFF;
    var contentFormat:TextFormat = new TextFormat(contentFontName, isConsole ? 15 : 16, textColor, false);
    var contentField:TextField = new TextField();
    contentField.embedFonts = contentFontEmbedded;
    contentField.defaultTextFormat = contentFormat;
    contentField.text = content;
    contentField.x = 8;
    contentField.y = titleBarHeight + 8;
    contentField.width = width - 16;
    contentField.height = Math.max(20, height - (titleBarHeight + 16));
    contentField.multiline = true;
    contentField.wordWrap = true;
    contentField.selectable = false;
    contentField.mouseEnabled = false;
    container.addChild(contentField);

    attachToStage(container);

    return {
      container: container,
      background: background,
      titleBar: titleBar,
      titleField: titleField,
      contentField: contentField
    };
  }

  function createWindows():Void
  {
    if (windowsCreated) return;

    var viewportWidth:Int = Std.int((FlxG.stage != null && FlxG.stage.stageWidth > 0) ? FlxG.stage.stageWidth : FlxG.width);
    var viewportHeight:Int = Std.int((FlxG.stage != null && FlxG.stage.stageHeight > 0) ? FlxG.stage.stageHeight : FlxG.height);

    var x:Float = 98;
    var y:Float = 10;
    var statusWidth:Int = Std.int(Math.min(statusWindowWidth, Math.max(120, viewportWidth - 20)));

    var statusPanel:Dynamic = createPanel(x, y, statusWidth, windowHeight, "STATUS", defaultStatusContent, false);
    statusWindow = statusPanel.container;
    statusBackground = statusPanel.background;
    statusTitleBar = statusPanel.titleBar;
    statusTitle = statusPanel.titleField;
    statusText = statusPanel.contentField;

    var logY:Float = y + windowHeight + 8;
    var logWidth:Int = Std.int(Math.min(logWindowWidth, Math.max(120, viewportWidth - 20)));
    maxWindowHeight = Std.int(Math.max(windowHeight, viewportHeight - logY - 10));

    var logPanel:Dynamic = createPanel(x, logY, logWidth, windowHeight, "LOG HISTORY", defaultLogContent, true);
    logWindow = logPanel.container;
    logBackground = logPanel.background;
    logTitleBar = logPanel.titleBar;
    logTitle = logPanel.titleField;
    logText = logPanel.contentField;

    windowsCreated = true;
  }

  function ensureWindows():Void
  {
    if (!windowsCreated)
    {
      createWindows();
    }
    else
    {
      // Re-attach if stage changed
      if (statusWindow != null && statusWindow.parent == null) attachToStage(statusWindow);
      if (logWindow != null && logWindow.parent == null) attachToStage(logWindow);
    }

    updateText(LOG);
    applyVisibility();
  }

  function attachToStage(container:Sprite):Void
  {
    if (container == null) return;

    if (FlxG.stage != null)
    {
      FlxG.stage.addChild(container);
    }
    else
    {
      FlxG.addChildBelowMouse(container);
    }
  }

  function destroySpriteContainer(sprite:Sprite):Void
  {
    if (sprite == null) return;

    while (sprite.numChildren > 0)
    {
      sprite.removeChildAt(0);
    }

    if (sprite.parent != null)
    {
      sprite.parent.removeChild(sprite);
    }
  }

  function destroyWindows():Void
  {
    destroySpriteContainer(statusWindow);
    destroySpriteContainer(logWindow);

    statusWindow = null;
    logWindow = null;

    statusBackground = null;
    statusTitleBar = null;
    statusTitle = null;
    statusText = null;

    logBackground = null;
    logTitleBar = null;
    logTitle = null;
    logText = null;

    lastStatusHeight = -1;
    lastLogHeight = -1;

    windowsCreated = false;
  }

  function updateLogPosition():Void
  {
    if (statusWindow == null || logWindow == null || statusBackground == null) return;

    var gap:Float = 8;
    var currentStatusHeight:Float = statusBackground.height > 0 ? statusBackground.height : windowHeight;
    logWindow.y = statusWindow.y + currentStatusHeight + gap;
  }

  // Refresh text based on type STATUS or LOG
  function updateText(type:Int):Void
  {
    switch (type)
    {
      case STATUS:
      {
        if (statusWindow == null || statusText == null || statusBackground == null) return;

        statusText.text = getStatus();

        var requiredHeight:Int = Math.ceil(statusText.textHeight + titleBarHeight + 18);
        var targetHeight:Int = Std.int(Math.max(windowHeight, Math.min(requiredHeight, maxWindowHeight)));

        // resize if height is changed
        if (targetHeight != lastStatusHeight)
        {
          lastStatusHeight = targetHeight;
          statusText.height = Math.max(20, targetHeight - (titleBarHeight + 12));
          drawShape(statusBackground, statusText.width + 16, targetHeight, 0x101820); // redraw background

          // Reposition Log whenever Status height changes.
          updateLogPosition();
        }
      }
      case LOG:
      {
        if (logWindow == null || logText == null || logBackground == null) return;

        var textContent:String = messages.join("\n");
        logText.text = (textContent == "") ? defaultLogContent : textContent;

        var requiredHeight:Int = Math.ceil(logText.textHeight + titleBarHeight + 18);
        var targetHeight:Int = Std.int(Math.max(windowHeight, Math.min(requiredHeight, maxWindowHeight)));

        // resize if height is changed
        if (targetHeight != lastLogHeight)
        {
          lastLogHeight = targetHeight;
          logText.height = Math.max(20, targetHeight - (titleBarHeight + 12));
          drawShape(logBackground, logText.width + 16, targetHeight, 0x101820); // redraw background
        }

        // Scroll to the newest lines when content exceeds the clamped height.
        logText.scrollV = logText.maxScrollV;
      }
    }
  }

  // Formats milliseconds as m:ss (e.g. 125000 -> "2:05").
  function formatDuration(ms:Float):String
  {
    var totalSeconds:Int = Math.round(ms / 1000);
    var minutes:Int = Std.int(totalSeconds / 60);
    var seconds:Int = totalSeconds % 60;

    return minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
  }

  // show status
  function getStatus():String
  {
    var perfHeader:String = 'FPS: ${currentFPS} (${frameMs}ms)\n'
      + '1% LOW: ${onePercentLowFPS}\n'
      + 'GC MEM: ${gcMem}\n\n';

    if (windowMode == 'basic') return perfHeader;

    var playState:PlayState = PlayState.instance;

    if (playState == null)
    {
      return perfHeader + "Currently not in PlayState";
    }

    var stageName:String = null;
    var difficulty:String = null;
    var song:String = null;
    var boyfriend:String = null;
    var girlfriend:String = null;
    var dad:String = null;
    var songLengthMs:Float = 0;
    var songPositionMs:Float = 0;

    if (playState.currentSong != null)
    {
      var currentSong = playState.currentSong;
      difficulty = playState.currentDifficulty;

      var music = FlxG.sound.music;
      var conductor = Conductor.instance;

      if (music != null) songLengthMs = music.length;
      if (conductor != null) songPositionMs = Math.max(0, conductor.songPosition);

      var songLabel:String = currentSong.id;

      if (songLengthMs > 0 && songPositionMs > 0 && songPositionMs < songLengthMs)
      {
        songLabel += ' (${formatDuration(songPositionMs)} / ${formatDuration(songLengthMs)})';
      }

      song = songLabel;
    }

    if (playState.currentStage != null)
    {
      var currentStage = playState.currentStage;
      stageName = currentStage.id;

      if (currentStage.getBoyfriend() != null) boyfriend = currentStage.getBoyfriend().characterId;
      if (currentStage.getDad() != null) dad = currentStage.getDad().characterId;
      if (currentStage.getGirlfriend() != null) girlfriend = currentStage.getGirlfriend().characterId;
    }

    return perfHeader
      + 'SONG: ${safe(song)}\n'
      + 'STAGE: ${safe(stageName)}\n'
      + 'DIFFICULTY: ${safe(difficulty)}\n'
      + 'BF: ${safe(boyfriend)}\n'
      + 'GF: ${safe(girlfriend)}\n'
      + 'DAD: ${safe(dad)}';
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    // register fonts from fonts/
    var titleFontInfo:Dynamic = loadAndRegisterFont("GoogleSansCode-Bold.ttf");
    titleFontName = titleFontInfo.fontName;
    titleFontEmbedded = titleFontInfo.embedded;

    var contentFontInfo:Dynamic = loadAndRegisterFont("GoogleSansCode-Medium.ttf");
    contentFontName = contentFontInfo.fontName;
    contentFontEmbedded = contentFontInfo.embedded;

    // adjust max samples based on target fps * windowSeconds
    maxSamples = Std.int(FlxG.drawFramerate * windowSeconds);

    // load values from option page
    loadOptionValues();
    ensureWindows();
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    destroyWindows();
  }

  // log voice player paths
  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (!isDefaultLogsDisabled)
    {
      var playState:PlayState = PlayState.instance;

      if (playState != null && playState.currentChart != null)
      {
        var allVoicePaths:Array<String> =
          playState.currentChart.buildPlayerVoiceList().concat(playState.currentChart.buildOpponentVoiceList());

        log("[Voice Paths] " + allVoicePaths.join(", "));
      }
    }
  }

  // status update
  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);

    // dont process if window is not visible.
    if (windowMode == 'none') return;

    var timeScale:Float = FlxG.timeScale;

    // At timeScale 0, elapsed is always 0 and real frame time can't be recovered.
    if (timeScale <= 0) return;

    var elapsed:Float = event.elapsed / timeScale;

    // record frame time and remove old one
    frameTimes.push(elapsed);
    if (frameTimes.length > maxSamples) frameTimes.shift();

    // Count frames for the FPS estimate.
    fpsFrameCount++;
    fpsElapsed += elapsed;
    statusRefreshTimer += elapsed;

    if (statusRefreshTimer < refreshInterval) return;

    // FPS averaged over the elapsed measurement window.
    currentFPS = Math.round(fpsFrameCount / fpsElapsed);
    frameMs = Math.round((fpsElapsed / fpsFrameCount) * 10000) / 10;
    onePercentLowFPS = calculateOnePercentLow();

    fpsFrameCount = 0;
    fpsElapsed = 0;

    // Memory reported by OpenFL
    gcMem = getMemoryLabel();

    // Preserve leftover time so the interval doesn't drift as much.
    statusRefreshTimer %= refreshInterval;

    updateText(STATUS);
  }

  override function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeEnd(event);
    ensureWindows();
  }

  // store text to logs.
  public function log(message:String):Void
  {
    messages.push(message);

    if (messages.length > maxMessages) messages.shift();

    updateText(LOG);
  }

  public function enableDefaultLogs():Void
  {
    isDefaultLogsDisabled = false;
  }

  public function disableDefaultLogs():Void
  {
    isDefaultLogsDisabled = true;
  }

  public function clearLogs():Void
  {
    messages = [];
    updateText(LOG);
  }
}
