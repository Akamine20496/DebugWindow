package funkin.play;

import funkin.Paths;
import funkin.play.PlayState;
import funkin.save.Save;
import funkin.modding.events.CountdownScriptEvent;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.ScriptEvent.StateChangeScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.modding.module.Module;
import flixel.FlxG;
import openfl.display.Sprite;
import openfl.display.Shape;
import openfl.text.Font;
import openfl.text.TextField;
import openfl.text.TextFormat;
import openfl.utils.Assets;
import openfl.system.System;
import StringTools;

class DebugWindow extends Module
{
  // OpenFL window containers
  var statusWindow:Sprite;
  var logWindow:Sprite;

  // Window dimensions
  var statusWindowWidth:Int = 340;
  var logWindowWidth:Int = 380;
  var windowHeight:Int = 80;
  var maxWindowHeight:Int = 360;
  var titleBarHeight:Int = 34;

  // Status window and OpenFL children
  var STATUS(default, null):Int = 0;
  var statusBackground:Shape;
  var statusTitleBar:Shape;
  var statusTitle:TextField;
  var statusText:TextField;

  // Log window and OpenFL children
  var LOG(default, null):Int = 1;
  var logBackground:Shape;
  var logTitleBar:Shape;
  var logTitle:TextField;
  var logText:TextField;

  // corner radius
  var cornerRadius:Float = 16;

  // FIFO console
  var messages:Array<String> = [];
  var maxMessages:Int = 10;

  var windowsCreated:Bool = false;

  // fps and ram
  var statusRefreshTimer:Float = 0;
  var fpsElapsed:Float = 0;
  var fpsFrameCount:Int = 0;
  var currentFPS:Int = 0;
  var gcMem:String = 0;
  var peakMemBytes:Float = 0;

  // values from option page
  var isWindowVisible:Bool;
  var windowOpacity:Float;
  var windowRefreshInterval:Float;

  // resolved font names and embed state
  var titleFontName:String = "_sans";
  var titleFontEmbedded:Bool = false;
  var contentFontName:String = "_sans";
  var contentFontEmbedded:Bool = false;

  public function new()
  {
    super("DebugWindow");
  }

  // setter / preview functions from option page section
  public function updateWindowVisibility():Void
  {
    try
    {
      isWindowVisible = cast Save.instance.modOptions.get("debugWindowVisible");
    }
    catch (_:Dynamic)
    {
      log('[Window Visible Option] Fallback to true.');
      isWindowVisible = true;
    }
    applyVisibility();
  }

  public function updateWindowOpacity():Void
  {
    try
    {
      windowOpacity = cast Save.instance.modOptions.get("debugWindowOpacity");
    }
    catch (_:Dynamic)
    {
      log('[Window Opacity Option] Fallback to 1.0.');
      windowOpacity = 1.0;
    }

    // update opacity of status window
    if (statusBackground != null) statusBackground.alpha = windowOpacity;
    if (statusTitleBar != null) statusTitleBar.alpha = windowOpacity;
    // update opacity of debug console window
    if (logBackground != null) logBackground.alpha = windowOpacity;
    if (logTitleBar != null) logTitleBar.alpha = windowOpacity;
  }

  public function updateWindowRefreshInterval():Void
  {
    try
    {
      windowRefreshInterval = cast Save.instance.modOptions.get("debugWindowRefreshInterval");
    }
    catch (_:Dynamic)
    {
      log('[Window Refresh Interval Option] Fallback to 100.0.');
      windowRefreshInterval = 100.0;
    }
  }

  // class functions and lifecycle section
  function loadOptionValues():Void
  {
    try
    {
      isWindowVisible = cast Save.instance.modOptions.get("debugWindowVisible");
      windowOpacity = cast Save.instance.modOptions.get("debugWindowOpacity");
      windowRefreshInterval = cast Save.instance.modOptions.get("debugWindowRefreshInterval");
    }
    catch (_:Dynamic)
    {
      log('[Window Options] Fallback to default values.');
      isWindowVisible = true;
      windowOpacity = 1.0;
      windowRefreshInterval = 100.0;
    }
  }

  function loadAndRegisterFont(fontAssetPath:String, fallbackName:String = "_sans"):Dynamic
  {
    var candidates:Array<String> = [];

    if (fontAssetPath != null && StringTools.trim(fontAssetPath) != "")
    {
      var resolvedFromPaths:String = Paths.font(fontAssetPath);

      if (resolvedFromPaths != null && StringTools.trim(resolvedFromPaths) != "")
      {
        candidates.push(resolvedFromPaths);
      }

      if (!candidates.contains(fontAssetPath))
      {
        candidates.push(fontAssetPath);
      }
    }

    for (candidate in candidates)
    {
      var font:Font = null;

      if (Assets.exists(candidate))
      {
        try
        {
          font = Assets.getFont(candidate);
        }
        catch (_:Dynamic)
        {
          font = null;
        }
      }

      if (font == null)
      {
        try
        {
          font = Font.fromFile(candidate);
        }
        catch (_:Dynamic)
        {
          font = null;
        }
      }

      if (font != null)
      {
        try
        {
          Font.registerFont(font);
        }
        catch (_:Dynamic) {}

        if (font.fontName != null && StringTools.trim(font.fontName) != "")
        {
          return {
            fontName: font.fontName,
            embedded: true
          };
        }
      }
    }

    return {
      fontName: fallbackName,
      embedded: false
    };
  }

  function applyVisibility():Void
  {
    if (statusWindow != null) statusWindow.visible = isWindowVisible;
    if (logWindow != null) logWindow.visible = isWindowVisible;
  }

  function getStatusRefreshInterval():Float
  {
    var interval:Float = windowRefreshInterval;

    interval = Math.max(100, Math.min(200, interval));

    return interval / 1000;
  }

  function safe(value:Dynamic, fallback:String = "NULL"):String
  {
    if (value == null) return fallback;

    var result:String = Std.string(value);

    if (result == null || StringTools.trim(result) == "") return fallback;

    return result;
  }

  function getMemoryLabel():String
  {
    var currentBytes:Float = System.totalMemoryNumber;

    if (currentBytes > peakMemBytes) peakMemBytes = currentBytes;

    return '${formatBytes(currentBytes)} / ${formatBytes(peakMemBytes)}';
  }

  function formatBytes(bytes:Float):String
  {
    var mb:Float = bytes / 1024 / 1024;

    if (mb >= 1024)
    {
      var gb:Float = Math.round((mb / 1024) * 100) / 100;
      return '$gb GB';
    }

    var roundedMb:Float = Math.round(mb * 100) / 100;
    return '$roundedMb MB';
  }

  function drawTitleBarShape(bar:Shape, width:Float):Void
  {
    var r:Float = cornerRadius;
    var h:Float = titleBarHeight;
    var halfR:Float = Math.min(r, h * 0.5);

    bar.graphics.clear();
    bar.graphics.beginFill(0x243746, 1);
    // Top-left and top-right rounded corners; square bottom corners
    bar.graphics.drawRoundRect(0, 0, width, h, r, r);
    if (h > halfR)
    {
      bar.graphics.drawRect(0, halfR, width, h - halfR);
    }
    bar.graphics.endFill();
    bar.alpha = windowOpacity;
  }

  function drawWindowBackground(bg:Shape, width:Float, height:Float):Void
  {
    bg.graphics.clear();
    bg.graphics.beginFill(0x101820, 1);
    bg.graphics.drawRoundRect(0, 0, width, height, cornerRadius, cornerRadius);
    bg.graphics.endFill();
    bg.alpha = windowOpacity;
  }

  function createPanel(x:Float, y:Float, width:Int, height:Int, title:String, isConsole:Bool):
    {
      container:Sprite,
      background:Shape,
      titleBar:Shape,
      titleField:TextField,
      contentField:TextField
    }
  {
    var container:Sprite = new Sprite();
    container.x = x;
    container.y = y;
    container.mouseEnabled = false;
    container.mouseChildren = false;

    var background:Shape = new Shape();
    drawWindowBackground(background, width, height);
    container.addChild(background);

    var titleBar:Shape = new Shape();
    drawTitleBarShape(titleBar, width);
    container.addChild(titleBar);

    var titleFormat:TextFormat = new TextFormat(titleFontName, 20, 0xFFFFFF, true);
    var titleField:TextField = new TextField();
    titleField.embedFonts = titleFontEmbedded;
    titleField.x = 8;
    titleField.y = 4;
    titleField.width = width - 16;
    titleField.height = titleBarHeight - 4;
    titleField.selectable = false;
    titleField.mouseEnabled = false;
    titleField.text = title;
    titleField.defaultTextFormat = titleFormat;
    container.addChild(titleField);

    var textColor:Int = isConsole ? 0x00FF00 : 0xFFFFFF;
    var contentFormat:TextFormat = new TextFormat(contentFontName, isConsole ? 15 : 16, textColor, false);
    var contentField:TextField = new TextField();
    contentField.embedFonts = contentFontEmbedded;
    contentField.x = 8;
    contentField.y = titleBarHeight + 8;
    contentField.width = width - 16;
    contentField.height = Math.max(20, height - (titleBarHeight + 16));
    contentField.multiline = true;
    contentField.wordWrap = true;
    contentField.selectable = false;
    contentField.mouseEnabled = false;
    contentField.text = "";
    contentField.defaultTextFormat = contentFormat;
    container.addChild(contentField);

    attachToStage(container);

    return {
      container: container,
      background: background,
      titleBar: titleBar,
      titleField: titleField,
      contentField: contentField
    };
  }

  function createWindows():Void
  {
    if (windowsCreated) return;

    var viewportWidth:Int = Std.int((FlxG.stage != null && FlxG.stage.stageWidth > 0) ? FlxG.stage.stageWidth : FlxG.width);
    var viewportHeight:Int = Std.int((FlxG.stage != null && FlxG.stage.stageHeight > 0) ? FlxG.stage.stageHeight : FlxG.height);

    var statusWidth:Int = Std.int(Math.min(statusWindowWidth, Math.max(120, viewportWidth - 20)));
    var x:Float = 10;
    var y:Float = 10;

    var statusPanel:Dynamic = createPanel(x, y, statusWidth, windowHeight, "STATUS", false);
    statusWindow = statusPanel.container;
    statusBackground = statusPanel.background;
    statusTitleBar = statusPanel.titleBar;
    statusTitle = statusPanel.titleField;
    statusText = statusPanel.contentField;

    var logY:Float = y + windowHeight + 8;
    var logWidth:Int = Std.int(Math.min(logWindowWidth, Math.max(120, viewportWidth - 20)));
    maxWindowHeight = Std.int(Math.max(windowHeight, viewportHeight - logY - 10));

    var logPanel:Dynamic = createPanel(x, logY, logWidth, maxWindowHeight, "LOG HISTORY", true);
    logWindow = logPanel.container;
    logBackground = logPanel.background;
    logTitleBar = logPanel.titleBar;
    logTitle = logPanel.titleField;
    logText = logPanel.contentField;

    windowsCreated = true;
    applyVisibility();
  }

  function ensureWindows():Void
  {
    if (!windowsCreated)
    {
      createWindows();
    }
    else
    {
      // Re-attach if stage changed
      if (statusWindow != null && statusWindow.parent == null) attachToStage(statusWindow);
      if (logWindow != null && logWindow.parent == null) attachToStage(logWindow);
    }

    applyVisibility();
  }

  function attachToStage(container:Sprite):Void
  {
    if (container == null) return;

    if (FlxG.stage != null)
    {
      FlxG.stage.addChild(container);
    }
    else
    {
      FlxG.addChildBelowMouse(container);
    }
  }

  function destroySpriteContainer(sprite:Sprite):Void
  {
    if (sprite == null) return;

    while (sprite.numChildren > 0)
    {
      sprite.removeChildAt(0);
    }

    if (sprite.parent != null)
    {
      sprite.parent.removeChild(sprite);
    }
  }

  function destroyWindows():Void
  {
    destroySpriteContainer(statusWindow);
    destroySpriteContainer(logWindow);

    statusWindow = null;
    logWindow = null;

    statusBackground = null;
    statusTitleBar = null;
    statusTitle = null;
    statusText = null;

    logBackground = null;
    logTitleBar = null;
    logTitle = null;
    logText = null;

    windowsCreated = false;
  }

  function updateLogPosition():Void
  {
    if (statusWindow == null || logWindow == null || statusBackground == null) return;

    var gap:Float = 8;
    var currentStatusHeight:Float = statusBackground.height > 0 ? statusBackground.height : windowHeight;
    logWindow.y = statusWindow.y + currentStatusHeight + gap;
  }

  // Refresh text based on type STATUS or LOG
  function updateText(type:Int):Void
  {
    switch (type)
    {
      case STATUS:
        {
          if (statusWindow == null || statusText == null || statusBackground == null) return;

          statusText.text = getStatus();

          var requiredHeight:Int = Math.ceil(statusText.textHeight + titleBarHeight + 18);
          var targetHeight:Int = Std.int(Math.max(windowHeight, Math.min(requiredHeight, maxWindowHeight)));

          statusText.height = Math.max(20, targetHeight - (titleBarHeight + 12));
          drawWindowBackground(statusBackground, statusText.width + 16, targetHeight);

          // Reposition Debug Console whenever Status height changes.
          updateLogPosition();
        }
      case LOG:
        {
          if (logWindow == null || logText == null || logBackground == null) return;

          var textContent:String = messages.join("\n");
          logText.text = (textContent == "") ? "[Log] Waiting for log update" : textContent;

          var requiredHeight:Int = Math.ceil(logText.textHeight + titleBarHeight + 18);
          var targetHeight:Int = Std.int(Math.max(windowHeight, Math.min(requiredHeight, maxWindowHeight)));

          logText.height = Math.max(20, targetHeight - (titleBarHeight + 12));
          drawWindowBackground(logBackground, logText.width + 16, targetHeight);
        }
    }
  }

  // show status
  function getStatus():String
  {
    var playState:PlayState = PlayState.instance;

    if (playState == null)
    {
      return 'FPS: ${currentFPS}\n'
        + 'GC MEM: ${gcMem}\n\n'
        + "Currently not in PlayState";
    }

    var stageName:String = null;
    var difficulty:String = null;
    var songName:String = null;
    var stagePlayer:String = null;
    var stageOpponent:String = null;
    var playerVocals:Array<String> = null;

    if (playState.currentSong != null)
    {
      var currentSong = playState.currentSong;

      songName = currentSong.id;
      difficulty = playState.currentDifficulty;

      var songVariation = currentSong.getDifficulty(playState.currentDifficulty, playState.currentVariation);

      if (songVariation != null && songVariation.characters != null) playerVocals = songVariation.characters.playerVocals;
    }

    if (playState.currentStage != null)
    {
      var currentStage = playState.currentStage;

      if (currentStage.getBoyfriend() != null) stagePlayer = currentStage.getBoyfriend().characterId;
      if (currentStage.getDad() != null) stageOpponent = currentStage.getDad().characterId;

      stageName = currentStage.id;
    }

    return 'FPS: ${currentFPS}\n'
      + 'GC MEM: ${gcMem}\n\n'
      + 'Stage: ${safe(stageName)}\n'
      + 'Difficulty: ${safe(difficulty)}\n'
      + 'Song: ${safe(songName)}\n'
      + 'Player: ${safe(stagePlayer)}\n'
      + 'Opponent: ${safe(stageOpponent)}\n'
      + 'Player Vocals: ${safe(playerVocals)}';
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    // register fonts from fonts/
    var titleFontInfo:Dynamic = loadAndRegisterFont("fonts/GoogleSansCode-Bold.ttf");
    titleFontName = titleFontInfo.fontName;
    titleFontEmbedded = titleFontInfo.embedded;

    var contentFontInfo:Dynamic = loadAndRegisterFont("fonts/GoogleSansCode-Medium.ttf");
    contentFontName = contentFontInfo.fontName;
    contentFontEmbedded = contentFontInfo.embedded;

    // load values from option page
    loadOptionValues();

    ensureWindows();
    updateText(LOG);
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    destroyWindows();
  }

  // log voice player paths
  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    var playState:PlayState = PlayState.instance;

    if (playState != null && playState.currentChart != null)
    {
      var currentChart = playState.currentChart;
      var voicePaths = currentChart.buildPlayerVoiceList();

      log("[Player Voice Paths] " + voicePaths.join(", "));
    }
  }

  // status update
  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);

    var elapsed:Float = event.elapsed;

    // Count frames for the FPS estimate.
    fpsFrameCount++;
    fpsElapsed += elapsed;
    statusRefreshTimer += elapsed;

    var refreshInterval:Float = getStatusRefreshInterval();

    if (statusRefreshTimer < refreshInterval) return;

    // FPS averaged over the elapsed measurement window.
    if (fpsElapsed > 0) currentFPS = Math.round(fpsFrameCount / fpsElapsed);

    fpsFrameCount = 0;
    fpsElapsed = 0;

    // Memory reported by OpenFL
    gcMem = getMemoryLabel();

    // Preserve leftover time so the interval doesn't drift as much.
    statusRefreshTimer %= refreshInterval;

    updateText(STATUS);
  }

  override function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeEnd(event);
    ensureWindows();
  }

  // store text to logs.
  public function log(message:String):Void
  {
    messages.push(message);

    while (messages.length > maxMessages)
      messages.shift();

    updateText(LOG);
  }

  public function clearLogs():Void
  {
    messages = [];
    updateText(LOG);
  }
}
