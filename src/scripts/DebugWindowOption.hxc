package funkin.save;

import funkin.save.Save;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.StateChangeScriptEvent;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.ui.options.OptionsState;

class DebugWindowOption extends Module
{
  public function new()
  {
    super('DebugWindowOption');
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    var opts = Save.instance.modOptions;

    if (opts.get("debugWindowMode") == null
        && opts.get("debugWindowOpacity") == null)
    {
      opts.set("debugWindowMode", 'full');
      opts.set("debugWindowOpacity", 0.4);

      Save.instance.flush();
    }
  }

  public function onStateChangeEnd(event:StateChangeScriptEvent)
  {
    if (Std.isOfType(event.targetState, OptionsState))
    {
      var debugWindowModule:Null<DebugWindow> = cast ModuleHandler.getModule("DebugWindow");
      var preferencesPage = event.targetState.optionsCodex.pages.get("preferences");

      if (preferencesPage != null)
      {
        // Window Mode Option
        preferencesPage.createPrefItemEnum(
          'Debug Window',
          "Choose how much info the Debug Window shows.",
          [
            "None" => "none",
            "Basic" => "basic",
            "Full" => "full"
          ],
          function(key:String, value:String):Void
          {
            Save.instance.modOptions.set("debugWindowMode", value);
            Save.instance.flush();

            debugWindowModule.setWindowMode(value);
          },
          Save.instance.modOptions.get("debugWindowMode"));

          // Opacity Option
          preferencesPage.createPrefItemNumber(
            'Window Opacity',
            "Set the opacity for Debug Window.",
            function(value:Float):Void {
              Save.instance.modOptions.set("debugWindowOpacity", value);
              Save.instance.flush();

              debugWindowModule.setWindowOpacity(value);
            },
            function(value:Float):String {
              return Std.string(Math.round(value * 100)) + "%";
            },
            Save.instance.modOptions.get("debugWindowOpacity"),
            0.0, // min
            1.0, // max
            0.1, // step
            1 // decimal places
          );
      }
    }
  }
}
