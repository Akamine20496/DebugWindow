package funkin.save;

import funkin.save.Save;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.StateChangeScriptEvent;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.ui.options.OptionsState;

class DebugWindowOption extends Module
{
  public function new()
  {
    super('DebugWindowOption');
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    if (Save.instance.modOptions.get("debugWindowVisible") == null
      && Save.instance.modOptions.get("debugWindowOpacity") == null
      && Save.instance.modOptions.get("debugWindowRefreshInterval") == null)
    {
      Save.instance.modOptions.set("debugWindowVisible", true);
      Save.instance.modOptions.set("debugWindowOpacity", 1.0);
      Save.instance.modOptions.set("debugWindowRefreshInterval", 100);
      Save.instance.flush();
    }
  }

  public function onStateChangeEnd(event:StateChangeScriptEvent)
  {
    if (Std.isOfType(event.targetState, OptionsState))
    {
      var debugWindowModule:Null<DebugWindow> = cast ModuleHandler.getModule("DebugWindow");
      var preferencesPage = event.targetState.optionsCodex.pages.get("preferences");

      if (preferencesPage != null)
      {
        // Visibility Option
        preferencesPage.createPrefItemCheckbox('Debug Window', "When enabled, Debug Window is visible.", function(value:Bool):Void {
          Save.instance.modOptions.set("debugWindowVisible", value);
          Save.instance.flush();

          debugWindowModule?.updateWindowVisibility();
        }, Save.instance.modOptions.get("debugWindowVisible"));
        // Opacity Option
        preferencesPage.createPrefItemNumber('Window Opacity', "Set the opacity for Debug Window.", function(value:Float):Void {
          Save.instance.modOptions.set("debugWindowOpacity", value);
          Save.instance.flush();

          debugWindowModule?.updateWindowOpacity();
        }, function(value:Float):String {
          return Std.string(Math.round(value * 100)) + "%";
        }, Save.instance.modOptions.get("debugWindowOpacity"), 0.0, // min
          1.0, // max
          0.1, // step
          1 // decimal places
        );
        // Status Refresh Interval Option
        preferencesPage.createPrefItemNumber('Status Refresh Interval',
          "Set the refresh interval for Status in Debug Window.\n(Affects FPS and GC MEM status)", function(value:Float):Void {
            Save.instance.modOptions.set("debugWindowRefreshInterval", value);
            Save.instance.flush();

            debugWindowModule?.updateWindowRefreshInterval();
        }, function(value:Float):String {
            return Std.string(value) + "ms";
        }, Save.instance.modOptions.get("debugWindowRefreshInterval"), 100.0, // min
          200.0, // max
          10.0 // step
        );
      }
    }
  }
}
